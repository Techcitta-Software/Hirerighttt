# Backend API Configuration
PORT=8787
NODE_ENV=production
ENVIRONMENT=production

# Security & Sessions (32+ random characters)
SESSION_SECRET=your_random_32_character_secret_here
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini AI Configuration
EXPERIENTIALLABS_API_KEY=your_experientiallabs_key
OPENAI_API_KEY=your_experientiallabs_key
GEMINI_API_KEY=your_experientiallabs_key
OPENAI_BASE_URL=https://api.experientiallabs.ai/v1
PRIMARY_MODEL=gpt-6-luna
FALLBACK_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-6-luna

# Optional: backend/node/scripts/probe-models.mjs (defaults to GEMINI_API_KEY / OPENAI_API_KEY)
# PROBE_KEY=

# Optional Fallback Keys
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Supabase Auth & PostgreSQL Database (optional, defaults to local db.json)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Demo Accounts & Registration
ALLOW_DEMO_ACCOUNTS=true
SIGNUP_ENABLED=true
