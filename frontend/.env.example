# Frontend → API Connection
# Dev: leave empty to use Vite proxy → localhost:8787
# Prod (Vercel): leave empty — vercel.json rewrites /api → Render
# VITE_API_URL=http://localhost:8787
VITE_API_URL=

# Supabase Auth & Database (optional)
VITE_AUTH_PROVIDER=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Google Gemini AI Configuration (dev-only client fallback)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_PRIMARY_MODEL=gemini-2.5-flash
VITE_FALLBACK_MODEL=gemini-1.5-flash
VITE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VITE_ALLOW_CLIENT_LLM=true  # never enable in public production
