# ═══════════════════════════════════════════════════════════════════
# HireRight — copy this file to `.env` at the REPO ROOT (one file only)
# ═══════════════════════════════════════════════════════════════════

# ─── Node API (required) ───
PORT=8787
ENVIRONMENT=development
NODE_ENV=development
# Optional: serve built frontend from the API (after npm run build). Auto-on when dist/index.html exists.
# SERVE_FRONTEND=true
# FRONTEND_DIST=frontend/dist
SESSION_SECRET=replace_with_at_least_32_random_characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Production: ALLOW_DEMO_ACCOUNTS=false, STRICT_PRODUCTION_CONFIG=true, TRUST_PROXY=true
ALLOW_DEMO_ACCOUNTS=true
SIGNUP_ENABLED=true

# ─── Frontend (Vite — same file, VITE_ prefix) ───
# Leave VITE_API_URL empty in dev to use Vite proxy → localhost:8787
VITE_API_URL=
# Public URL candidates open for /apply/… links (e.g. https://app.yourdomain.com). Dev: leave empty → localhost:5173
# VITE_PUBLIC_APP_URL=
# api = one account per email + phone on Neon; separate candidate vs vendor roles (production)
VITE_AUTH_PROVIDER=api

# Supabase (storage + optional auth) — Vite also reads NEXT_PUBLIC_* from repo-root .env
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=same-as-anon-key
# SUPABASE_SERVICE_ROLE_KEY=optional-for-admin-uploads
# SUPABASE_RESUME_BUCKET=resumes
# Dev-only offline users when VITE_AUTH_PROVIDER is not api
# VITE_ALLOW_LOCAL_DEMO=true
# Temporary QA — skip scheduled slot gate for interviews (do not enable in production)
# VITE_ALLOW_IMMEDIATE_INTERVIEW_TEST=true

# Dev-only: client LLM fallback when API is down (never set keys in public prod builds)
# VITE_GEMINI_API_KEY=
# VITE_PRIMARY_MODEL=gemini-2.5-flash
# VITE_FALLBACK_MODEL=gemini-1.5-flash
# VITE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VITE_ALLOW_CLIENT_LLM=false

# Optional TTS
# VITE_ELEVENLABS_API_KEY=
# VITE_ELEVENLABS_VOICE_ID=

# ─── AI (Node API — server-side interview + resume) ───
# Google AI Studio — standard keys (AIza…) or auth keys (AQ.…): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Low-cost Flash Lite (recommended for AI Studio keys; override if you have 2.5 access)
PRIMARY_MODEL=gemini-3.5-flash-lite
FAST_MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.5-flash-lite
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ─── Gmail SMTP (required for interview booking confirmation emails) ───
# Create a 16-character App Password: https://myaccount.google.com/apppasswords
# (2-Step Verification must be ON). Backend uses nodemailer + service: gmail.
#
# SMTP_EMAIL=your_project@gmail.com
# SMTP_APP_PASSWORD=abcdefghijklmnop
# EMAIL_FROM="HireRight AI <your_project@gmail.com>"
#
# Invite links: {PUBLIC_APP_URL}/interview/invite/{token}
#
# Where invite links must point (production):
# PUBLIC_APP_URL=https://hire-rightt.vercel.app
#
# Optional: minutes allowed to join after start (default 5 → 2:00 AM join until 2:05 AM)
# INVITE_JOIN_WINDOW_MINUTES=5
#
# Local dev:
# PUBLIC_APP_URL=http://localhost:5173

# ─── Production overrides (or use .env.production.example) ───
# TRUST_PROXY=true
# STRICT_PRODUCTION_CONFIG=true

# ─── Optional Python API (backend/python) — reads this same `.env` ───
# SECRET_KEY= same as SESSION_SECRET or separate
# DEBUG=false
