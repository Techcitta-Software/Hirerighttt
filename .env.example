# ═══════════════════════════════════════════════════════════════════
# HireRight — copy this file to `.env` at the REPO ROOT (one file only)
# ═══════════════════════════════════════════════════════════════════

# ─── Node API (required) ───
PORT=8787
ENVIRONMENT=development
NODE_ENV=development
# Optional: serve built frontend from the API (after npm run build). Auto-on when dist/index.html exists.
# SERVE_FRONTEND=true
# FRONTEND_DIST=frontend/dist
SESSION_SECRET=replace_with_at_least_32_random_characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional dev-only: if Vite proxy fails, frontend calls API directly (default http://127.0.0.1:8787)
# VITE_DEV_API_FALLBACK=http://127.0.0.1:8787
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# If Neon fails with getaddrinfo ENOTFOUND, some routers block DNS — Node uses 8.8.8.8 / 1.1.1.1 by default.
# USE_SYSTEM_DNS=true
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Production: ALLOW_DEMO_ACCOUNTS=false, STRICT_PRODUCTION_CONFIG=true, TRUST_PROXY=true
ALLOW_DEMO_ACCOUNTS=true
SIGNUP_ENABLED=true

# ─── Frontend (Vite — same file, VITE_ prefix) ───
# Leave VITE_API_URL empty in dev to use Vite proxy → localhost:8787
VITE_API_URL=
# Public URL candidates open for /apply/… links (e.g. https://app.yourdomain.com). Dev: leave empty → localhost:5173
# VITE_PUBLIC_APP_URL=
# api = Neon PostgreSQL + Node API only (recommended). Ignores Supabase Auth/Storage even if keys exist below.
VITE_AUTH_PROVIDER=api
# Optional: hard-disable Supabase on the Node backend (resume storage). Auto-off when S3_BUCKET is set.
# DISABLE_SUPABASE=true

# ─── Amazon S3 (Node API only — never add AWS vars with VITE_ prefix) ───
# Single bucket (S3_BUCKET). All four private object types go here under tenants/… — no app-side migration.
#   1) resumes          tenants/{tenant}/candidates/{id}/resumes/…
#   2) interview transcripts  tenants/{tenant}/interviews/{sessionId}/transcripts/transcript.json
#   3) interview reports      tenants/{tenant}/interviews/{sessionId}/reports/interview_report.pdf
#   4) interview recordings   tenants/{tenant}/interviews/{sessionId}/recordings/…
# After replacing a bucket: update S3_BUCKET (+ IAM policy on the NEW bucket only), restart API, re-upload resumes / re-run interviews. Old bucket is never contacted.
# When AWS_REGION + S3_BUCKET are set, S3 is used for resumes. Otherwise Supabase resume storage is used if configured.
# Recommended with Neon: DISABLE_SUPABASE=true
#
# REQUIRED for S3 resume storage (backend reads these at runtime):
AWS_REGION=us-east-1
S3_BUCKET=your-hireright-private-files-bucket
#
# REQUIRED on Render / local dev unless the server uses an IAM instance/task role (EC2/ECS/Lambda):
# Create an IAM user with policy on s3:PutObject, GetObject, HeadObject, DeleteObject on arn:aws:s3:::BUCKET/*
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=replace_with_secret_from_iam_access_key
#
# OPTIONAL — temporary credentials (STS / assumed role); usually leave unset
# AWS_SESSION_TOKEN=
#
# OPTIONAL — presigned download link lifetime in seconds (default 900 = 15 minutes)
# S3_PRESIGN_EXPIRES_SECONDS=900
#
# OPTIONAL — tenant namespace for B2C candidates without an employer org (default: platform)
# S3_DEFAULT_TENANT_ID=platform
#
# OPTIONAL — max interview recording upload size in bytes (default 104857600 = 100 MB)
# S3_MAX_RECORDING_BYTES=104857600
#
# OPTIONAL — max interview report PDF upload (default 12000000 = ~12 MB)
# S3_MAX_REPORT_BYTES=12000000
# Server builds interview_report.pdf from HTML after /api/interview/score (Playwright Chromium).
# Install once on the API host: npx playwright install chromium
# SCORECARD_PDF_DISABLED=1
#
# OPTIONAL — same as AWS_REGION if you already use this name elsewhere
# AWS_DEFAULT_REGION=us-east-1
#
# ─── S3 Neon DB backups (separate from resume bucket — npm run db:backup:s3) ───
# S3_BACKUP_BUCKET=your-hireright-neon-backups-bucket
# S3_BACKUP_PREFIX=neon/hireright/
# Backup script also expects AWS_REGION + AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY unless using AWS CLI profile.

# Supabase (optional legacy — leave commented when using VITE_AUTH_PROVIDER=api + DATABASE_URL Neon + S3)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_RESUME_BUCKET=resumes
# Dev-only offline users when VITE_AUTH_PROVIDER is not api
# VITE_ALLOW_LOCAL_DEMO=true
# Temporary QA — skip scheduled slot gate for interviews (do not enable in production)
# VITE_ALLOW_IMMEDIATE_INTERVIEW_TEST=true

# Dev-only: client LLM fallback when API is down (never set keys in public prod builds)
# VITE_GEMINI_API_KEY=
# VITE_PRIMARY_MODEL=gemini-2.5-flash
# VITE_FALLBACK_MODEL=gemini-1.5-flash
# VITE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VITE_ALLOW_CLIENT_LLM=false

# Optional TTS
# VITE_ELEVENLABS_API_KEY=
# VITE_ELEVENLABS_VOICE_ID=

# ─── AI (Node API — server-side interview + resume) ───
# Google AI Studio — standard keys (AIza…) or auth keys (AQ.…): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Low-cost Flash Lite (recommended for AI Studio keys; override if you have 2.5 access)
PRIMARY_MODEL=gemini-3.5-flash-lite
FAST_MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.5-flash-lite
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ─── Groq Whisper (server-side interview STT — never expose GROQ_API_KEY to Vite) ───
# GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_WHISPER_LANGUAGE=en

# ─── Gmail SMTP (required for interview booking confirmation emails) ───
# Create a 16-character App Password: https://myaccount.google.com/apppasswords
# (2-Step Verification must be ON). Backend uses nodemailer + service: gmail.
#
# SMTP_EMAIL=your_project@gmail.com
# SMTP_APP_PASSWORD=abcdefghijklmnop
# EMAIL_FROM="HireRight AI <your_project@gmail.com>"
#
# Invite links: {PUBLIC_APP_URL}/interview/invite/{token}
#
# Where invite links must point (production):
# PUBLIC_APP_URL=https://hire-rightt.vercel.app
#
# Optional: minutes allowed to join after start (default 5 → 2:00 AM join until 2:05 AM)
# INVITE_JOIN_WINDOW_MINUTES=5
#
# Local dev:
# PUBLIC_APP_URL=http://localhost:5173

# ─── Production overrides (or use .env.production.example) ───
# TRUST_PROXY=true
# STRICT_PRODUCTION_CONFIG=true

# ─── Optional Python API (backend/python) — reads this same `.env` ───
# SECRET_KEY= same as SESSION_SECRET or separate
# DEBUG=false
