# HireRighttt — one .env at the repo root, read by the API (backend/app/load_env.py) and by Vite (envDir = repo root).
# Copy to .env and fill in. Never commit .env. On AWS these values live in SSM Parameter Store, not in a file.
#
# REQUIRED = the app will not work (or refuses to start in production) without it.
# Everything else is optional; the default shown is what the code uses when it is unset.

# ─── Runtime ────────────────────────────────────────────────────────────────
# REQUIRED. development | staging | production (staging/production enforce the checks in node_config.py)
ENVIRONMENT=development
PORT=8787
# REQUIRED in production: exact frontend origin(s), comma separated, no "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true behind CloudFront/nginx so client IPs come from the proxy headers (always on in staging/production).
# TRUST_PROXY=false
# LOG_LEVEL=INFO
# WEB_CONCURRENCY=2
# MAX_REQUEST_BYTES=3000000
# API_GZIP=1

# ─── Database (Postgres) ────────────────────────────────────────────────────
# REQUIRED: either DATABASE_URL …
DATABASE_URL=postgresql://user:password@host:5432/hireright?sslmode=require
# … or, on AWS RDS, the parts (DATABASE_URL wins when both are set):
# DB_HOST=
# DB_PORT=5432
# DB_NAME=hireright
# DB_USER=hireright
# DB_PASSWORD=
# PG_SSL_ROOT_CERT=          # path to the RDS CA bundle for sslmode=verify-full
# PG_DIRECT_DNS=false
# DB_POOL_MIN=1
# DB_POOL_MAX=10
# DB_POOL_CHECK_IDLE_SECONDS=
# TEST_DATABASE_URL=         # local/CI Postgres for DB tests only

# ─── Auth & accounts ────────────────────────────────────────────────────────
# REQUIRED in production: at least 32 random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SIGNUP_ENABLED=true
# Demo logins with known passwords. Local development only; the API refuses to start with true in staging/production.
ALLOW_DEMO_ACCOUNTS=false
# ADMIN_EMAILS=admin@example.com

# ─── AI (Google Gemini) ─────────────────────────────────────────────────────
# REQUIRED in production. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Extra keys for failover: GEMINI_API_KEY_2=, GEMINI_API_KEY_3=, … or GEMINI_API_KEYS=key1,key2
PRIMARY_MODEL=gemini-3.1-flash-lite
FAST_MODEL=gemini-3.1-flash-lite
# QUALITY_MODEL=
# ASSESSMENT_EVALUATION_MODEL=
# GEMINI_FALLBACK_MODELS=
# GEMINI_MAX_CONCURRENCY=24
# INTERVIEW_THINKING=minimal
# RESUME_PARSE_THINKING=minimal
# Optional OpenRouter failover
# OPENROUTER_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ─── Interview voice ────────────────────────────────────────────────────────
# TTS_ENABLED=true
# TTS_MODEL=
# TTS_VOICE=
# TTS_FALLBACK_MODELS=
# INVITE_JOIN_WINDOW_MINUTES=15
# INVITE_DAILY_RECIPIENT_LIMIT=
# PADDLE_OCR_ENABLED=true

# ─── Email ──────────────────────────────────────────────────────────────────
# smtp (default) | resend (used automatically when RESEND_API_KEY is set)
# MAIL_PROVIDER=smtp
# REQUIRED for invites / password reset (SMTP):
SMTP_EMAIL=
SMTP_APP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
EMAIL_FROM="HireRighttt <no-reply@example.com>"
# CONTACT_INBOX_EMAIL=       # defaults to SMTP_EMAIL
# RESEND_API_KEY=

# ─── File storage (AWS S3) ──────────────────────────────────────────────────
# REQUIRED for resume / recording uploads.
AWS_REGION=ap-south-1
S3_BUCKET=
# S3_EXPECTED_BUCKET=        # refuse to start if S3_BUCKET differs (guards against a wrong bucket)
# Local only. On EC2 leave both unset: the instance role provides credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_DEFAULT_TENANT_ID=platform
# S3_PRESIGN_EXPIRES_SECONDS=
# S3_MAX_RECORDING_BYTES=
# S3_MAX_REPORT_BYTES=
# S3_CONNECT_TIMEOUT_SECONDS=
# S3_READ_TIMEOUT_SECONDS=
# S3_MAX_ATTEMPTS=
# S3_MAX_POOL_CONNECTIONS=
# RECORDING_RETENTION_DAYS=  # unset = keep recordings
# AUDIT_RETENTION_DAYS=

# ─── Payments (interview retakes, Razorpay) ─────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RETAKE_PRICE_INR=89

# ─── Scheduled jobs, scaling, monitoring ────────────────────────────────────
# REQUIRED in production: guards /api/internal/* (reminders, maintenance).
CRON_SECRET=
# REQUIRED with more than one API instance (shared rate limits).
# REDIS_URL=
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=
# STRICT_PRODUCTION_CONFIG=false
# READ_CACHE_TTL_S=
# SESSION_CACHE_TTL_S=
# OPEN_JOBS_CACHE_TTL_S=
# OPEN_JOBS_SUMMARY_LIMIT=

# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Every VITE_* value is built into the public JavaScript. Never put a secret (API key, DB URL, password) here.
# Empty = same-origin /api (Vite dev proxy locally, CloudFront/nginx in production).
VITE_API_URL=
# VITE_PUBLIC_APP_URL=https://your-domain   # also read by the API for links in emails; PUBLIC_APP_URL works too
#   Origin only (no path). Unset: share links use the browser's origin, and email links (invites, resets) use the
#   recruiter's request origin when it is listed in CORS_ORIGINS. Required in production for cron reminder emails.
# api = accounts in the Python API + Postgres (default for this deployment)
VITE_AUTH_PROVIDER=api
# VITE_ADMIN_EMAILS=
# VITE_ENABLE_DEMO_ACCOUNTS=false
# VITE_NEURAL_VOICE=true
# VITE_BLOCK_MULTI_MONITOR=false
# VITE_ENABLE_DEEPFILTER_NET3=true
# VITE_DEEPFILTER_CDN_URL=
# VITE_DEEPFILTER_SUPPRESSION_LEVEL=
# Local development only
# VITE_DEV_PORT=5173
# VITE_API_PROXY_TARGET=http://127.0.0.1:8787
# VITE_DEV_API_FALLBACK=http://127.0.0.1:8787
# VITE_ALLOW_IMMEDIATE_INTERVIEW_TEST=false
