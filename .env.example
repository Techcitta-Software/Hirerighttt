# ═══════════════════════════════════════════════════════════════════
# HireRight — copy this file to `.env` at the REPO ROOT (one file only)
# ═══════════════════════════════════════════════════════════════════

# ─── Node API (required) ───
PORT=8787
ENVIRONMENT=development
NODE_ENV=development
SESSION_SECRET=replace_with_at_least_32_random_characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
ALLOW_DEMO_ACCOUNTS=true
SIGNUP_ENABLED=true

# ─── Frontend (Vite — same file, VITE_ prefix) ───
# Leave VITE_API_URL empty in dev to use Vite proxy → localhost:8787
VITE_API_URL=
VITE_AUTH_PROVIDER=api

# Dev-only: client LLM fallback when API is down (never set keys in public prod builds)
# VITE_GEMINI_API_KEY=
# VITE_PRIMARY_MODEL=gemini-2.5-flash
# VITE_FALLBACK_MODEL=gemini-1.5-flash
# VITE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VITE_ALLOW_CLIENT_LLM=false

# Optional TTS
# VITE_ELEVENLABS_API_KEY=
# VITE_ELEVENLABS_VOICE_ID=

# ─── AI (Node API — server-side interview + resume) ───
# Google AI Studio — standard keys (AIza…) or auth keys (AQ.…): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Low-cost Flash Lite (recommended for AI Studio keys; override if you have 2.5 access)
# Interview questions use PRIMARY_MODEL via backend/node/interviewAgent.mjs
PRIMARY_MODEL=gemini-3.1-flash-lite
FAST_MODEL=gemini-3.1-flash-lite
FALLBACK_MODEL=gemini-3.5-flash-lite
LITE_FALLBACK_MODEL=gemini-flash-lite-latest
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ─── Groq Whisper (Silero VAD utterances → server transcription) ───
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_WHISPER_LANGUAGE=en

# ─── Production overrides (or use .env.production.example) ───
# TRUST_PROXY=true
# STRICT_PRODUCTION_CONFIG=true

# ─── Optional Python API (backend/python) — reads this same `.env` ───
# SECRET_KEY= same as SESSION_SECRET or separate
# DEBUG=false
