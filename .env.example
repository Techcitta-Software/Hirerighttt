# Frontend → API Connection
VITE_API_URL=http://localhost:8787
PORT=8787

# ─── Supabase (Auth + Postgres + sync) ───
VITE_AUTH_PROVIDER=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Node API (server only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=your_jwt_secret
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Leave local auth: VITE_AUTH_PROVIDER=local (omit Supabase vars)

# ExperientialLabs / AI Gateway (interview agent)
EXPERIENTIALLABS_API_KEY=your_experientiallabs_key
OPENAI_API_KEY=your_experientiallabs_key
GEMINI_API_KEY=your_experientiallabs_key
OPENAI_BASE_URL=https://api.experientiallabs.ai/v1
PRIMARY_MODEL=gpt-6-luna
FALLBACK_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-6-luna
# Optional: only used after primary+fallback 404 on Google-native keys (AQ./AIza)
LLM_TERTIARY_MODEL=gemini-3.8-flash
# Max wait per model before template backup (default 45000 ms)
LLM_REQUEST_TIMEOUT_MS=45000

# Optional fallback keys
OPENROUTER_API_KEY=

# Dev-only browser fallback (omit in production builds)
VITE_EXPERIENTIALLABS_API_KEY=your_experientiallabs_key
VITE_EXPERIENTIALLABS_BASE_URL=https://api.experientiallabs.ai/v1
VITE_PRIMARY_MODEL=gpt-6-luna
VITE_FALLBACK_MODEL=gemini-2.5-flash
# VITE_ALLOW_CLIENT_LLM=true  # never enable in public production
