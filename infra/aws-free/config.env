# HireRight TEST environment on the AWS Free Tier. Not secret (secrets go to SSM Parameter Store).
AWS_REGION=ap-south-1
# Gets the $1 budget alert (the first cent of spend) - fill in before bootstrap
ALERT_EMAIL=CHANGE_ME@CHANGE_ME.com
# Email for the app: smtp (Gmail app password via set-param.sh). SES is not used in the test environment.
EMAIL_PROVIDER=smtp
