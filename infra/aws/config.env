# HireRighttt AWS settings (no secrets here — secrets go into SSM with ./set-secrets.sh).
AWS_PROFILE=hirerighttt-admin     # aws configure --profile hirerighttt-admin (an IAM user that can deploy)
AWS_REGION=ap-south-1             # Mumbai: closest to Indian users. Free tier is the same in every region.
ENV=prod
STACK=hirerighttt-prod
INSTANCE_TYPE=t3.micro            # free tier: t3.micro (or t2.micro)
CREATE_DATABASE=false             # false = keep DATABASE_URL (Neon). true = free-tier RDS PostgreSQL (12 months).
RESUME_BUCKET=hirerighttt-tests   # existing bucket with resumes / videos / reports
RESUME_BUCKET_REGION=us-east-1    # that bucket's region
BUDGET_EMAIL=                     # REQUIRED: your email for the $1 budget alert
