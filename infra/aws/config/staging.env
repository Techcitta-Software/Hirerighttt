# HireRight on AWS: STAGING (deployed from the dev1 branch). Not secret: secrets live in AWS Secrets Manager.
AWS_REGION=ap-south-1

# Fill these in (the deploy refuses to run while they say CHANGE_ME)
DOMAIN_NAME=staging.CHANGE_ME.com
HOSTED_ZONE_ID=CHANGE_ME
ALERT_EMAIL=CHANGE_ME@CHANGE_ME.com

# Email: smtp (Gmail/Resend credentials in the app secret) or ses (Amazon SES; verify the domain first)
EMAIL_PROVIDER=smtp
EMAIL_FROM=

# Size (small: about $130-170/month)
NAT_GATEWAYS=1
AURORA_MIN_ACU=0.5
AURORA_MAX_ACU=4
AURORA_READER=false
BACKUP_RETENTION_DAYS=7
TASK_CPU=512
TASK_MEMORY=1024
MIN_TASKS=1
MAX_TASKS=2
WEB_CONCURRENCY=2
DB_POOL_MAX=8
