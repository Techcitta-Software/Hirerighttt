# HireRight on AWS: PRODUCTION (deployed from the main branch, after approval). Not secret.
AWS_REGION=ap-south-1

# Fill these in (the deploy refuses to run while they say CHANGE_ME)
DOMAIN_NAME=app.CHANGE_ME.com
HOSTED_ZONE_ID=CHANGE_ME
ALERT_EMAIL=CHANGE_ME@CHANGE_ME.com

# Email: smtp (Gmail/Resend credentials in the app secret) or ses (Amazon SES; verify the domain first)
EMAIL_PROVIDER=smtp
EMAIL_FROM=

# Size: highly available baseline (about $350-500/month), scales out automatically with traffic.
# 100k+ users: autoscaling adds API containers (up to MAX_TASKS) and Aurora capacity (up to AURORA_MAX_ACU).
# Connections at full scale = MAX_TASKS x WEB_CONCURRENCY x DB_POOL_MAX = 10 x 4 x 8 = 320 (Aurora at 16 ACU allows
# far more). Add RDS Proxy before raising MAX_TASKS much further.
NAT_GATEWAYS=2
AURORA_MIN_ACU=1
AURORA_MAX_ACU=16
AURORA_READER=true
BACKUP_RETENTION_DAYS=14
TASK_CPU=1024
TASK_MEMORY=2048
MIN_TASKS=2
MAX_TASKS=10
WEB_CONCURRENCY=4
DB_POOL_MAX=8
