{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoListTables",
      "Effect": "Allow",
      "Action": ["dynamodb:ListTables", "dynamodb:DescribeLimits"],
      "Resource": "*"
    },
    {
      "Sid": "HireRightDynamoTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:CreateTable",
        "dynamodb:UpdateTable",
        "dynamodb:DeleteTable",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:ConditionCheckItem",
        "dynamodb:TagResource",
        "dynamodb:UntagResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:521575031641:table/hirerighttt-*",
        "arn:aws:dynamodb:us-east-1:521575031641:table/hirerighttt-*/index/*",
        "arn:aws:dynamodb:us-east-1:521575031641:table/content",
        "arn:aws:dynamodb:us-east-1:521575031641:table/content/index/*"
      ]
    }
  ]
}