{
  "name": "hirerighttt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend/node"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "node backend/node/index.mjs",
    "dev:python": "cd backend/python && python run.py",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:free-api-port": "node scripts/ensure-dev-api-port.mjs",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview",
    "start": "node backend/node/index.mjs",
    "server": "node backend/node/index.mjs",
    "server:py": "cd backend/python && python run.py",
    "test:e2e": "playwright test",
    "prod:neon": "docker compose -f docker-compose.prod.yml up -d --build",
    "db:init": "npm --prefix backend/node run db:init",
    "db:verify": "npm --prefix backend/node run db:verify",
    "db:purge": "node backend/node/scripts/purge-all-data.mjs",
    "db:purge-keep-demos": "node backend/node/scripts/purge-keep-demo-accounts.mjs",
    "s3:purge-data": "node backend/node/scripts/s3-purge-object-data.mjs",
    "check:env": "node scripts/check-env.mjs",
    "s3:test": "node backend/node/scripts/test-s3-resume-storage.mjs",
    "s3:test:recording": "node backend/node/scripts/test-s3-recording-upload.mjs",
    "test:interview-api": "node backend/node/scripts/test-interview-api-flow.mjs",
    "test:scorecard-report": "node --test backend/node/tests/scorecard-report.test.mjs",
    "s3:cors": "node backend/node/scripts/apply-s3-cors.mjs",
    "s3:cleanup-legacy": "node backend/node/scripts/s3-cleanup-legacy.mjs",
    "s3:cleanup-legacy:delete": "node backend/node/scripts/s3-cleanup-legacy.mjs --delete",
    "check:llm": "npm --prefix backend/node run check:llm",
    "check:smoke": "npm --prefix backend/node run check:smoke",
    "verify:prod": "node scripts/verify-production.mjs",
    "mail:test": "node backend/node/scripts/test-smtp.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "framer-motion": "^12.43.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "pdf-lib": "^1.17.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
