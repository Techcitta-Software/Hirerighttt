{
  "name": "hirerighttt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8787 --reload",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview",
    "start": "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8787",
    "db:init": "cd backend && python db_init.py",
    "db:verify": "cd backend && python db_init.py --verify",
    "db:dynamo:init": "cd backend && python dynamo_init.py",
    "db:dynamo:verify": "cd backend && python dynamo_init.py --verify",
    "db:dynamo:seed": "cd backend && python dynamo_init.py --seed",
    "db:dynamo:migrate": "cd backend && python dynamo_init.py --migrate",
    "db:dynamo:probe": "cd backend && python scripts/dynamo_probe.py",
    "db:dynamo:inventory": "cd backend && python scripts/dynamo_inventory.py",
    "db:dynamo:e2e": "cd backend && python scripts/e2e_dynamo_full_check.py"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
